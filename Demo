    {"Donante": "Mercado Unicachi", "Alimento": "20 Kg de Papas y Verduras frescas", "Hora": "Hace 10 min"},
    {"Donante": "Panadería El Sol", "Alimento": "15 Bolsas de pan del día", "Hora": "Hace 35 min"}
]

