# Widgets del Formulario
input_donante = widgets.Text(placeholder='Ej. Minimarket VES', description='Donante:')
input_alimento = widgets.Text(placeholder='Ej. 10 Kg de Arroz', description='Alimento:')
btn_enviar = widgets.Button(description='Publicar Donación', button_style='warning')
output_notificacion = widgets.Output()

# Contenedor para la lista de donaciones dinámicas
listado_donaciones = widgets.VBox()

def actualizar_lista():
    cartas = []
    for donacion in donaciones_data:
        carta_html = f"""
        <div class='card'>
            <strong>📍 {donacion['Donante']}</strong><br>
            🎁 Donó: {donacion['Alimento']}<br>
            <small style='color: gray;'>🕒 {donacion['Hora']}</small>
        </div>
        """
        cartas.append(widgets.HTML(value=carta_html))
    listado_donaciones.children = cartas

def registrar_donacion(b):
    donante = input_donante.value.strip()
    alimento = input_alimento.value.strip()
    if donante and alimento:
        donaciones_data.insert(0, {
            "Donante": donante,
            "Alimento": alimento,
            "Hora": "Justo ahora"
        })
        actualizar_lista()
        with output_notificacion:
            output_notificacion.clear_output()
            print(f"¡Gracias {donante}! Donación publicada con éxito.")
        input_donante.value = ''
        input_alimento.value = ''
    else:
        with output_notificacion:
            output_notificacion.clear_output()
            print("Por favor rellena ambos campos.")

btn_enviar.on_click(registrar_donacion)
actualizar_lista()

# Estructura visual de la App
titulo_app = widgets.HTML("<div class='phone-header'>📱 AlimentaVES <br><small style='font-size:0.7em;'>ODS 2: Villa El Salvador</small></div>")

seccion_donar_titulo = widgets.HTML("<h4>🙋‍♂️ ¿Quieres Donar Alimentos?</h4>")
seccion_donar = widgets.VBox([seccion_donar_titulo, input_donante, input_alimento, btn_enviar, output_notificacion])

seccion_comunidad_titulo = widgets.HTML("<h4>🍲 Últimas Donaciones Activas:</h4>")

# Emular contenedor de celular
phone_layout = widgets.VBox([
    titulo_app,
    widgets.VBox([seccion_donar, seccion_comunidad_titulo, listado_donaciones], layout=widgets.Layout(padding='15px', overflow='y-scroll', height='480px'))
], layout=widgets.Layout(width='360px', height='600px', border='8px solid #333', border_radius='25px', overflow='hidden', background_color='#f9f9f9'))

display(phone_layout)
